# DataMind Enterprise - Backend Environment Configuration
# Copy this file to .env and adjust as needed

# ── Ollama Settings ─────────────────────────────────────────────
# URL where Ollama is running
OLLAMA_URL=http://localhost:11434

# Default model to use for AI analysis
# Options: llama3.2, llama3.1:8b, mistral, phi3, gemma2:2b, etc.
OLLAMA_MODEL=llama3.2

# ── Server Settings ─────────────────────────────────────────────
# Port for FastAPI backend
PORT=8000

# ── CORS Settings ───────────────────────────────────────────────
# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ── File Upload Settings ─────────────────────────────────────────
# Maximum file size in MB
MAX_FILE_SIZE_MB=100

# ── Session Settings ─────────────────────────────────────────────
# Max sessions to keep in memory (older ones will be evicted)
MAX_SESSIONS=50
